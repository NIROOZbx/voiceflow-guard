# Server configuration
HOST=0.0.0.0
PORT=8080

# Shared secret for authenticating requests (sent in X-Backend-Secret or Authorization: Bearer <secret>)
BACKEND_SECRET=your_backend_secret_here

# PostgreSQL connection string
# Format: postgres://username:password@localhost:5432/database_name?sslmode=disable
DATABASE_URL=postgres://postgres:postgres@localhost:5432/voiceflow_guard?sslmode=disable
